{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome (localhost:3000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/app/src/*",
                "webpack:///./src/*": "${webRoot}/app/src/*",
                "webpack:///*": "${webRoot}/*",
                "/*": "${webRoot}/*"
            },
            "userDataDir": "${workspaceFolder}/.vscode/chrome"
        }
    ]
}